# ==========================================
# SuikaBot - Environment Configuration
# Copy this file to .env and fill in values
# ==========================================

# ── Environment ───────────────────────────
# Options: development, production, test
NODE_ENV=development
# Timezone for scheduled cron tasks (e.g. Asia/Jakarta, Asia/Makassar, UTC)
TZ="Asia/Jakarta"

# ── Logger Level ──────────────────────────
# Options: fatal, error, warn, info, debug, trace, silent (Default: 'debug' in dev, 'info' in prod)
LOG_LEVEL="debug"

# ── Bot Identity ──────────────────────────
# BOT_NAME is automatically sanitized to form Redis namespace prefix
# Example: "SuikaBot" -> "suikabot:development:", "suikabot:production:", "suikabot:test:"
BOT_NAME="SuikaBot"
BOT_PREFIX="."

# ── Authentication ────────────────────────
# Set USE_PAIRING_CODE=true for Dokploy/Docker (headless, no terminal display needed)
# Set USE_PAIRING_CODE=false to use QR Code via terminal
USE_PAIRING_CODE=true
# Phone number to pair with (digits only, no +, spaces, or dashes, e.g. 62895xxxxxxxx)
PAIRING_NUMBER="6281234567890"

# ── Redis Infrastructure ──────────────────
# Your Redis connection URL
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL="redis://localhost:6379"

# ── Human-like Randomized Rate Limiting ───
# Minimum and maximum delay between outbound replies in milliseconds
# Avoid fixed delays to ensure bot interaction appears natural to WhatsApp filters
RATE_LIMIT_MIN_DELAY_MS=3000
RATE_LIMIT_MAX_DELAY_MS=5000
# Maximum concurrent message processing tasks
RATE_LIMIT_MAX_CONCURRENT=10

# ── Scheduled Cron Jobs ───────────────────
# Enable or disable background cron schedules
ENABLE_SCHEDULES=true

# ── HTTP Webhook Server ───────────────────
# Enable or disable embedded HTTP webhook server
ENABLE_WEBHOOK=true
# Port for Webhook HTTP Server (e.g. Dokploy/external integrations)
WEBHOOK_PORT=3000
